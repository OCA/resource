<odoo>
    <record id="resource_role_form" model="ir.ui.view">
        <field name="name">resource.role.form</field>
        <field name="model">resource.role</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_resources"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-users"
                        >
                            <field name="resource_count" string="Resources" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Technician" />
                        </h1>
                    </div>
                    <group name="main">
                        <field name="color" widget="color_picker" />
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="resource_role_list" model="ir.ui.view">
        <field name="name">resource.role.list</field>
        <field name="model">resource.role</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="resource_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="action_resource_role" model="ir.actions.act_window">
        <field name="name">Service Roles</field>
        <field name="res_model">resource.role</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first service role
            </p>
            <p>
                Roles describe the function a resource fulfils, such as
                technician, supervisor or driver.
            </p>
        </field>
    </record>
</odoo>
